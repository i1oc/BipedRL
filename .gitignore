# ===========================================================================
# BipedRL .gitignore
# The Unity project lives in the BipedRL/ subfolder, so Unity patterns are
# anchored there instead of at the repository root.
# ===========================================================================

# --- Unity: generated folders (also excluded from the delivery .zip) -------
/BipedRL/[Ll]ibrary/
/BipedRL/[Tt]emp/
/BipedRL/[Oo]bj/
/BipedRL/[Ll]ogs/
/BipedRL/[Uu]ser[Ss]ettings/
/BipedRL/[Bb]uild/
/BipedRL/[Bb]uilds/
/BipedRL/[Mm]emoryCaptures/
/BipedRL/[Rr]ecordings/

# Unity: never ignore .meta files (they hold asset GUIDs)
!/BipedRL/[Aa]ssets/**/*.meta

# Unity: Asset Store tools and generated plugin folders
/BipedRL/[Aa]ssets/AssetStoreTools*
/BipedRL/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity: IDE files regenerated by the editor
/BipedRL/*.csproj
/BipedRL/*.unityproj
/BipedRL/*.sln
/BipedRL/*.slnx
/BipedRL/*.suo
/BipedRL/*.tmp
/BipedRL/*.user
/BipedRL/*.userprefs
/BipedRL/*.pidb
/BipedRL/*.booproj
/BipedRL/*.svd
/BipedRL/*.pdb
/BipedRL/*.mdb
/BipedRL/*.opendb
/BipedRL/*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity: crash reports and build artefacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# Unity: auto-generated streaming assets for Addressables (not used yet)
/BipedRL/[Aa]ssets/[Ss]treamingAssets/aa.meta
/BipedRL/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- ML-Agents / Python training -----------------------------------------
# Training output (checkpoints, TensorBoard logs). The chosen .onnx policies
# are copied by hand into BipedRL/Assets/BipedRL/Policies/ and committed there.
/training/results/
/training/summaries/
/training/builds/
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ML-Agents writes profiling timers into Assets/ML-Agents/ on every Play.
# These rules come after the .meta exception so the folder's .meta is ignored too.
/BipedRL/[Aa]ssets/ML-Agents/
/BipedRL/[Aa]ssets/ML-Agents.meta

# --- Course material (kept locally only, not ours to publish) -------------
/docs/course/

# --- Delivery packaging (zips are built locally and uploaded to the campus)
/deliveries/
*.zip

# --- Editors and OS ----------------------------------------------------------
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
